# Copy to .env and adjust. Every value has a working default for `docker compose up`.

# emulator = ring-sandbox (webhooks, scenarios); playground = Ring Developer Playground (real API, polled)
RING_MODE=emulator

# Shared HMAC key: the emulator signs webhooks with it, the API verifies with it.
RING_WEBHOOK_SIGNING_KEY=dev-signing-key-change-me

# Optional: a Playground token to start with (valid ~30 min). Usually pasted at runtime instead:
#   curl -X POST localhost:8000/settings/playground-token -H 'content-type: application/json' -d '{"token":"..."}'
RING_PLAYGROUND_TOKEN=

HOUSEHOLD_NAME=Demo household
HOUSEHOLD_TIMEZONE=Asia/Kolkata
